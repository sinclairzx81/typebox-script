{
  "name": "typebox-script",
  "displayName": "TypeBox Script",
  "description": "Syntax Highlighting for TypeBox Types",
  "version": "0.9.2",
  "publisher": "sinclairzx81",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinclairzx81/typebox-script"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "typebox-script",
        "extensions": [
          ".box"
        ],
        "configuration": "./src/language-configuration.json",
        "icon": {
          "light": "./icons/typebox-light-box.svg",
          "dark": "./icons/typebox-dark-box.svg"
        }
      },
      {
        "id": "typebox-script-tb",
        "extensions": [
          ".tb"
        ],
        "configuration": "./src/language-configuration.json",
        "icon": {
          "light": "./icons/typebox-light-tb.svg",
          "dark": "./icons/typebox-dark-tb.svg"
        }
      },
      {
        "id": "typebox-script-tbx",
        "extensions": [
          ".tbx"
        ],
        "configuration": "./src/language-configuration.json",
        "icon": {
          "light": "./icons/typebox-light-tbx.svg",
          "dark": "./icons/typebox-dark-tbx.svg"
        }
      }
    ],
    "grammars": [
      {
        "scopeName": "typebox.script",
        "path": "./src/typebox-script.json",
        "injectTo": [
          "source.ts",
          "source.tsx",
          "source.js",
          "source.jsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript"
        }
      },
      {
        "language": "typebox-script",
        "scopeName": "source.typebox-script",
        "path": "./src/typebox-script-box.json"
      },
      {
        "language": "typebox-script-tb",
        "scopeName": "source.typebox-script-tb",
        "path": "./src/typebox-script-tb.json"
      },
      {
        "language": "typebox-script-tbx",
        "scopeName": "source.typebox-script-tbx",
        "path": "./src/typebox-script-tbx.json"
      }
    ]
  }
}